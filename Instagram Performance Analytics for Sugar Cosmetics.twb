  <worksheets>
    <worksheet name=' Hashtag Analysis'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#f56040' fontsize='14' underline='true'> Hashtag Analysis</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Sheet1 (sugar_cosmetics_clean)' name='federated.0uoypt71sadzz518c4u700y8cchq' />
          </datasources>
          <datasource-dependencies datasource='federated.0uoypt71sadzz518c4u700y8cchq'>
            <column datatype='string' name='[Audience Emotion]' role='dimension' type='nominal' />
            <column caption='Total Engagement' datatype='integer' name='[Calculation_1842551960731648]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Likes] + [Comments] + [Shares] + [Saves]' />
            </column>
            <column caption=' Engagement Rate' datatype='real' default-format='p0.00%' name='[Calculation_1842551960825857]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1842551960731648]) / SUM([Reach])' />
            </column>
            <column caption='Post Month' datatype='datetime' name='[Calculation_1842551961288706]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [Post Date])' />
            </column>
            <column caption='Primary Hashtag' datatype='string' name='[Calculation_1842552034357266]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE TRUE&#13;&#10;WHEN CONTAINS([Hashtags], &quot;#SugarCosmetics&quot;) THEN &quot;#SugarCosmetics&quot;&#13;&#10;WHEN CONTAINS([Hashtags], &quot;#MakeupGoals&quot;) THEN &quot;#MakeupGoals&quot;&#13;&#10;WHEN CONTAINS([Hashtags], &quot;#BoldLooks&quot;) THEN &quot;#BoldLooks&quot;&#13;&#10;WHEN CONTAINS([Hashtags], &quot;#VeganBeauty&quot;) THEN &quot;#VeganBeauty&quot;&#13;&#10;WHEN CONTAINS([Hashtags], &quot;#CrueltyFree&quot;) THEN &quot;#CrueltyFree&quot;&#13;&#10;END' />
            </column>
            <column datatype='string' name='[Campaign Type]' role='dimension' type='nominal' />
            <column datatype='integer' name='[Comments]' role='measure' type='quantitative' />
            <column datatype='string' name='[Hashtags]' role='dimension' type='nominal' />
            <column datatype='integer' name='[Likes]' role='measure' type='quantitative' />
            <column datatype='date' name='[Post Date]' role='dimension' type='ordinal' />
            <column datatype='string' name='[Post Type]' role='dimension' type='nominal' />
            <column datatype='integer' name='[Reach]' role='measure' type='quantitative' />
            <column datatype='integer' name='[Saves]' role='measure' type='quantitative' />
            <column datatype='integer' name='[Shares]' role='measure' type='quantitative' />
            <column-instance column='[Audience Emotion]' derivation='None' name='[none:Audience Emotion:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1842552034357266]' derivation='None' name='[none:Calculation_1842552034357266:nk]' pivot='key' type='nominal' />
            <column-instance column='[Campaign Type]' derivation='None' name='[none:Campaign Type:nk]' pivot='key' type='nominal' />
            <column-instance column='[Post Type]' derivation='None' name='[none:Post Type:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1842551961288706]' derivation='Month-Trunc' name='[tmn:Calculation_1842551961288706:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1842551960825857]' derivation='User' name='[usr:Calculation_1842551960825857:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0uoypt71sadzz518c4u700y8cchq].[Action (Post Type)]'>
            <groupfilter function='level-members' level='[Post Type]' user:ui-action-filter='[Action1_2AA05BA1449A41549A3C62DCD9094282]' user:ui-enumeration='all' user:ui-marker='enumerate' />
