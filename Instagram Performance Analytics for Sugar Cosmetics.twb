      <column datatype='integer' name='[Follows]' role='measure' type='quantitative' />
      <column caption='Hashtags - Split 1' datatype='string' name='[Hashtags - Split 1]' role='dimension' type='nominal' user:SplitFieldIndex='1' user:SplitFieldOrigin='[federated.0uoypt71sadzz518c4u700y8cchq].[Hashtags]'>
        <calculation class='tableau' formula='TRIM( SPLIT( SPLIT( [Hashtags], &quot;#&quot;, 2 ), &quot;,&quot;, 1 ) )' />
