      </column>
      <column caption='Hastag_SugarCosmetics' datatype='boolean' name='[Calculation_1842552033009677]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CONTAINS([Hashtags], &quot;#SugarCosmetics&quot;)' />
      </column>
      <column caption='Hastag_MakeupGoals' datatype='boolean' name='[Calculation_1842552033255438]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CONTAINS([Hashtags], &quot;#MakeupGoals&quot;)' />
      </column>
      <column caption='Hastag_BoldLooks' datatype='boolean' name='[Calculation_1842552033460239]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CONTAINS([Hashtags], &quot;#BoldLooks&quot;)' />
      </column>
      <column caption='Hastag_VeganBeauty' datatype='boolean' name='[Calculation_1842552033660944]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CONTAINS([Hashtags], &quot;#VeganBeauty&quot;)' />
      </column>
      <column caption='Hastag_CrueltyFree' datatype='boolean' name='[Calculation_1842552033796113]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CONTAINS([Hashtags], &quot;#CrueltyFree&quot;)' />
      </column>
      <column caption='Primary Hashtag' datatype='string' name='[Calculation_1842552034357266]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE TRUE&#13;&#10;WHEN CONTAINS([Hashtags], &quot;#SugarCosmetics&quot;) THEN &quot;#SugarCosmetics&quot;&#13;&#10;WHEN CONTAINS([Hashtags], &quot;#MakeupGoals&quot;) THEN &quot;#MakeupGoals&quot;&#13;&#10;WHEN CONTAINS([Hashtags], &quot;#BoldLooks&quot;) THEN &quot;#BoldLooks&quot;&#13;&#10;WHEN CONTAINS([Hashtags], &quot;#VeganBeauty&quot;) THEN &quot;#VeganBeauty&quot;&#13;&#10;WHEN CONTAINS([Hashtags], &quot;#CrueltyFree&quot;) THEN &quot;#CrueltyFree&quot;&#13;&#10;END' />
      </column>
