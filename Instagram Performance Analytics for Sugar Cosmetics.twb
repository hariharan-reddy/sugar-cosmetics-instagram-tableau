      <aliases enabled='yes' />
      <column caption='Total Engagement' datatype='integer' name='[Calculation_1842551960731648]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Likes] + [Comments] + [Shares] + [Saves]' />
      </column>
      <column caption=' Engagement Rate' datatype='real' default-format='p0.00%' name='[Calculation_1842551960825857]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1842551960731648]) / SUM([Reach])' />
      </column>
      <column caption='Post Month' datatype='datetime' name='[Calculation_1842551961288706]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [Post Date])' />
      </column>
      <column caption='Post Weekday' datatype='string' name='[Calculation_1842551961374723]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;weekday&apos;, [Post Date])' />
      </column>
      <column caption='Post Label' datatype='string' name='[Calculation_1842551961485316]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Post Type] + &quot; – &quot; + STR([Post ID])' />
      </column>
      <column caption='Total Posts' datatype='integer' name='[Calculation_1842551978565637]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([Post Date])' />
      </column>
      <column caption='Total Likes' datatype='integer' name='[Calculation_1842551978713094]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Likes])' />
      </column>
      <column caption='Total Comments' datatype='integer' name='[Calculation_1842551978782727]' role='measure' type='quantitative'>
